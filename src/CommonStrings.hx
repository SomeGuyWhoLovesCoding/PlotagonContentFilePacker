/**
 * Unity common-strings table — used by the TypeTree binary blob format.
 *
 * When a TypeTreeNode m_TypeStrOffset or m_NameStrOffset has the high bit
 * set (0x80000000), the low 31 bits are an index into this table.
 * Otherwise, the value is a byte offset into the per-SerializedFile string
 * buffer that follows the node array.
 *
 * Source: extracted from UnityPy lzma.tpk (https://github.com/K0lb3/UnityPy)
 * Public-domain reference data — same set is used by AssetRipper, AssetStudio,
 * and the original Unity editor.
 */
class CommonStrings {
    public static var MAP : Map<Int, String> = [
        0x00000000 => 'AABB',
